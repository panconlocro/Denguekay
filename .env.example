# Copiar como .env. No versionar credenciales. config.yaml da los valores por defecto y estas
# variables los reemplazan (en Render se cargan como variables del servicio; ver docs/backend/despliegue.md).

# Base de datos de la API.
# PostgreSQL/Supabase: postgresql+psycopg://usuario:clave@servidor:5432/base?sslmode=require
# SQLite, solo desarrollo: sqlite:///models/serving/backend.db
DATABASE_URL=
# Dueño del esquema para alembic upgrade head. Vacío: alembic usa DATABASE_URL (desarrollo local).
MIGRATION_DATABASE_URL=
# false con el pooler de Supabase en transaction mode (puerto 6543), que no admite sentencias preparadas.
DB_PREPARED_STATEMENTS=true

# Clave larga y aleatoria para X-API-Key. La lectura de datos agregados es pública.
API_KEY=
# Orígenes del frontend separados por comas (sin barra final). Vacío: el de config.yaml.
CORS_ORIGINS=
# true | false. Vacío: el de config.yaml.
SERVIR_NO_VALIDADAS=

# Almacenamiento de los paquetes de modelo: local | supabase. Vacío: el de config.yaml (local).
STORAGE_BACKEND=
# Solo con STORAGE_BACKEND=supabase: URL del proyecto (https://<ref>.supabase.co) y clave secreta
# (sb_secret_..., o la service_role heredada). Nunca en el frontend.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Carpeta de caché de los archivos descargados. Vacío: carpeta temporal del sistema.
STORAGE_CACHE_DIR=
