# Public read-only API; never put API_KEY or database credentials here.
VITE_API_BASE_URL=/api/v1
# Public environment label: api, demo-v2 or fixtures. Demo mode also verifies model identity.
VITE_DATA_SOURCE=api
# Development proxy target (not exposed to the browser).
API_PROXY_TARGET=http://127.0.0.1:8000
